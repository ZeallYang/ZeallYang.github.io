---
import '../styles/global.css';
import { Image } from 'astro:assets';
import { profile, academicLinks, sections, projects, publications, honors, services, organizedWorkshops } from '../data/profile';
import SiteHeader from '../components/SiteHeader.astro';
const mailto = `mailto:${profile.email}`;
const asset = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\/+/, '')}`;
const biographyPattern = new RegExp(`(${profile.biographyHighlights.map((phrase) => phrase.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name}｜{profile.englishName} · 学术主页</title>
    <meta name="description" content={profile.description} />
    <meta name="theme-color" content="#f8f7f3" />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    {Astro.site && <link rel="canonical" href={new URL(import.meta.env.BASE_URL, Astro.site)} />}
  </head>
  <body id="top">
    <a class="skip-link" href="#main">跳转至主要内容</a>
    <SiteHeader />

    <div class="page-layout">
      <aside class="sidebar" aria-label="个人资料和页面导航">
        <div class="profile-summary">
          {profile.avatar ? (
            <Image class="avatar" src={profile.avatar} alt={`${profile.name}的个人照片`} width={112} densities={[1, 2, 3]} format="webp" quality={85} loading="eager" decoding="async" />
          ) : (
            <div class="avatar initials" role="img" aria-label={`${profile.name}的姓名首字母标识，非真实肖像`}>
              <span aria-hidden="true">{profile.initials}</span>
            </div>
          )}
          <div class="identity">
            <h1>{profile.name}</h1>
            <p class="english-name" lang="en">{profile.englishName}</p>
            <p class="qualifications">{profile.qualifications}</p>
            <p class="affiliation">{profile.affiliation}</p>
          </div>
          <ul class="sidebar-keywords" aria-label="主要研究关键词">
            {profile.research.map((item) => <li>{item.title}</li>)}
          </ul>
          <a class="email-link" href={mailto}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 6 9 7 9-7" /></svg>
            {profile.email}
          </a>
          {academicLinks.length > 0 && <div class="academic-links">{academicLinks.map((link) => <a href={link.url}>{link.label}</a>)}</div>}
        </div>

        <nav class="section-nav" aria-label="页面章节">
          {sections.map((section, index) => (
            <a href={`#${section.id}`}>
              <span class="nav-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span>{section.label}</span>
              <span class="nav-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </nav>
      </aside>

      <main id="main" tabindex="-1">
        <section id="about" aria-labelledby="about-heading" class="about-section">
          <p class="eyebrow" lang="en">About Me</p>
          <h2 id="about-heading" class="intro-heading">个人简介<span class="heading-dot" aria-hidden="true">.</span></h2>
          <div class="biography">{profile.biography.map((paragraph) => <p>{paragraph.split(biographyPattern).map((part) => profile.biographyHighlights.includes(part) ? <strong>{part}</strong> : part)}</p>)}</div>
          <a class="recruit-shortcut" href="#contact"><span class="small-mark" aria-hidden="true">↗</span><span>欢迎对工业大数据与 AI 研究感兴趣的同学加入课题组</span><span class="shortcut-label">了解更多 <span aria-hidden="true">→</span></span></a>
        </section>

        <section id="research" aria-labelledby="research-heading">
          <div class="section-heading"><h2 id="research-heading">研究方向</h2><span lang="en">Research Interests</span></div>
          <ul class="research-list">
            {profile.research.map(({ title, topics = [] }, index) => (
              <li><span class="research-number" aria-hidden="true">0{index + 1}</span><h3>{title}</h3>{topics.length > 0 && <p>{topics.join(' · ')}</p>}</li>
            ))}
          </ul>
          {profile.keywords.length > 0 && <p class="keyword-line"><span>研究关键词</span>{profile.keywords.join(' / ')}</p>}
        </section>

        <section id="projects" aria-labelledby="projects-heading">
          <div class="section-heading"><h2 id="projects-heading">科研项目 <span class="count">{projects.length}</span></h2><span lang="en">Research Projects</span></div>
          {['主持', '参与'].map((role) => (
            <div class="project-group">
              <h3 class="group-heading">{role}<span>{projects.filter((project) => project.role === role).length} 项</span></h3>
              <ul class="project-list">
                {projects.filter((project) => project.role === role).map((project) => (
                  <li class="project-entry">
                    <div class="project-title"><h4>{project.title}</h4><span class:list={['role', { 'role-lead': role === '主持' }]}>{project.role}</span></div>
                    <div class="project-meta"><strong>{project.category}</strong><span class="date-range">{project.dates}</span></div>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>

        <section id="publications" aria-labelledby="publications-heading">
          <div class="section-heading"><h2 id="publications-heading">代表性论文 <span class="count">{publications.length}</span></h2><span lang="en">Selected Publications</span></div>
          <p class="section-note">* 表示通讯作者</p>
          <ol class="publication-list" lang="en">
            {publications.map((paper, index) => (
              <li class="publication-entry">
                <div class="paper-visual">
                  <span class="paper-badge">{paper.venueLabel} <span>{paper.year}</span></span>
                  {paper.image ? (
                    <a
                      class="paper-image-trigger"
                      href={asset(paper.image.src)}
                      data-figure-src={asset(paper.image.src)}
                      data-figure-caption={paper.image.caption || paper.image.alt}
                      aria-label={`放大查看：${paper.image.alt}`}
                      aria-haspopup="dialog"
                    >
                      <img class="paper-image" src={asset(paper.image.thumbnail || paper.image.src)} alt={paper.image.alt} width={paper.image.width} height={paper.image.height} loading="lazy" decoding="async" />
                      <span class="figure-hint" lang="zh-CN">点击查看大图 <span aria-hidden="true">↗</span></span>
                    </a>
                  ) : (
                    <div class="paper-placeholder" lang="zh-CN">
                      <span class="placeholder-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                      <span>论文图示待补充</span>
                    </div>
                  )}
                </div>
                <div class="paper-content">
                  <h3>{paper.url ? <a href={paper.url} target="_blank" rel="noopener noreferrer">{paper.title}</a> : paper.title}</h3>
                  <p class="authors">{paper.authors.split(/(Zeyu Yang\*?)/).map((author) => author.startsWith('Zeyu Yang') ? <strong>{author}</strong> : author)}.</p>
                  <p class="venue"><cite>{paper.venue}</cite><span class="venue-year">, {paper.year}.</span></p>
                  {paper.venueNote && <p class="venue-note" lang="zh-CN">（{paper.venueNote}）</p>}
                  {((paper.links?.length || 0) > 0 || paper.wechatUrl) && <div class="paper-links">
                    {paper.links?.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<span aria-hidden="true"> ↗</span></a>)}
                    {paper.wechatUrl && <a class="wechat-link" href={paper.wechatUrl} target="_blank" rel="noopener noreferrer" aria-label={`微信公众号解读：${paper.title}`}>
                      <svg class="wechat-icon" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="currentColor" d="M9 3C4.6 3 1 5.8 1 9.3c0 1.9 1.1 3.6 2.8 4.8L3 17l3.2-1.6c.8.2 1.8.3 2.8.3.4 0 .8 0 1.2-.1-.5-.8-.7-1.7-.7-2.6 0-3.6 3.4-6.5 7.5-6.5h.1C15.9 4.4 12.7 3 9 3Z" />
                        <path fill="currentColor" d="M23 13c0-3-2.9-5.4-6.5-5.4S10 10 10 13s2.9 5.4 6.5 5.4c.8 0 1.6-.1 2.3-.3L22 20l-.7-2.9c1.1-1 1.7-2.4 1.7-4.1Z" />
                        <g fill="#fff"><circle cx="6.3" cy="8" r="1" /><circle cx="11.7" cy="8" r="1" /><circle cx="14.3" cy="12" r=".8" /><circle cx="18.7" cy="12" r=".8" /></g>
                      </svg>
                      <span lang="zh-CN">微信公众号</span><span aria-hidden="true">↗</span>
                    </a>}
                  </div>}
                  {paper.highlights && paper.highlights.length > 0 && <ul class="paper-highlights" lang="zh-CN">{paper.highlights.map((highlight) => <li>{highlight}</li>)}</ul>}
                </div>
              </li>
            ))}
          </ol>
        </section>

        <section id="honors" aria-labelledby="honors-heading">
          <div class="section-heading"><h2 id="honors-heading">奖励荣誉 <span class="count">{honors.length}</span></h2><span lang="en">Honors &amp; Awards</span></div>
          <ul class="honor-list">{honors.map((honor) => <li class="honor-entry"><span class="honor-year">{honor.year}</span><span>{honor.text}</span></li>)}</ul>
        </section>

        {sections.filter((section) => section.id === 'workshops' || section.id === 'service').map((section) => (
          <section id={section.id} aria-labelledby={`${section.id}-heading`}>
            <div class="section-heading"><h2 id={`${section.id}-heading`}>{section.label} <span class="count">{section.id === 'workshops' ? organizedWorkshops.length : services.length}</span></h2><span lang="en">{section.english}</span></div>
            {section.id === 'workshops' ? (
              <ol class="workshop-list">
                {organizedWorkshops.map((workshop) => (
                  <li>
                    <h3>{workshop.conference}专题研讨会</h3>
                    <p>{workshop.topic}</p>
                    <p lang="en">{workshop.englishTopic}</p>
                  </li>
                ))}
              </ol>
            ) : <ul class="service-list">{services.map((service) => <li class="service-entry">{service}</li>)}</ul>}
          </section>
        ))}

        <section id="contact" class="contact-section" aria-labelledby="contact-heading">
          <p class="eyebrow" lang="en">Contact &amp; Opportunities</p>
          <h2 id="contact-heading">一起探索工业智能的前沿</h2>
          <p>{profile.recruiting}</p>
          <div class="contact-actions">
            <a class="contact-button" href={mailto}>邮件联系 <span lang="en">{profile.email}</span><span aria-hidden="true">↗</span></a>
            <a class="contact-button" href={asset('members/')}>学生培养 <span aria-hidden="true">→</span></a>
          </div>
        </section>

        <footer class="footer"><span>{profile.name} <span aria-hidden="true">/</span> <span lang="en">{profile.englishName}</span></span><a href="#top">返回页首 <span aria-hidden="true">↑</span></a></footer>
      </main>
    </div>

    <dialog class="paper-lightbox" aria-labelledby="figure-title" aria-describedby="figure-paper-title">
      <header class="lightbox-header">
        <div><h2 id="figure-title"></h2><p id="figure-paper-title" lang="en"></p></div>
        <button class="lightbox-close" type="button" aria-label="关闭图片" autofocus>×</button>
      </header>
      <div class="figure-stage" tabindex="0" aria-label="论文图示，放大后可拖动图片或滚动查看细节">
        <img class="lightbox-image" alt="" decoding="async" draggable="false" />
      </div>
      <footer class="lightbox-footer">
        <button class="figure-zoom" type="button" aria-pressed="false">放大细节</button>
        <a class="figure-original" target="_blank" rel="noopener noreferrer">打开原图 <span aria-hidden="true">↗</span></a>
      </footer>
    </dialog>

    <script>
      const lightbox = document.querySelector<HTMLDialogElement>('.paper-lightbox')!;
      const image = lightbox.querySelector<HTMLImageElement>('.lightbox-image')!;
      const stage = lightbox.querySelector<HTMLElement>('.figure-stage')!;
      const title = lightbox.querySelector<HTMLElement>('#figure-title')!;
      const paperTitle = lightbox.querySelector<HTMLElement>('#figure-paper-title')!;
      const zoom = lightbox.querySelector<HTMLButtonElement>('.figure-zoom')!;
      const original = lightbox.querySelector<HTMLAnchorElement>('.figure-original')!;
      let returnFocus: HTMLElement | null = null;
      let drag: { pointerId: number; x: number; y: number; left: number; top: number } | null = null;
      let backdropPressed = false;

      const stopDragging = () => {
        const pointerId = drag?.pointerId;
        drag = null;
        stage.classList.remove('is-dragging');
        if (pointerId !== undefined && stage.hasPointerCapture(pointerId)) stage.releasePointerCapture(pointerId);
      };
      const resetZoom = () => {
        stopDragging();
        stage.classList.remove('is-zoomed');
        zoom.textContent = '放大细节';
        zoom.setAttribute('aria-pressed', 'false');
        stage.scrollTo(0, 0);
      };
      const openFigure = (trigger: HTMLAnchorElement) => {
        if (lightbox.open) return;
        returnFocus = trigger;
        const thumbnail = trigger.querySelector<HTMLImageElement>('img')!;
        image.src = trigger.dataset.figureSrc!;
        image.alt = thumbnail.alt;
        title.textContent = trigger.dataset.figureCaption!;
        paperTitle.textContent = trigger.closest('.publication-entry')?.querySelector('h3')?.textContent || '';
        original.href = image.src;
        resetZoom();
        lightbox.showModal();
      };

      document.querySelectorAll<HTMLAnchorElement>('.paper-image-trigger').forEach((trigger) => {
        trigger.addEventListener('click', (event) => {
          if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          openFigure(trigger);
        });
      });
      zoom.addEventListener('click', () => {
        stopDragging();
        const expanded = stage.classList.toggle('is-zoomed');
        zoom.textContent = expanded ? '适应窗口' : '放大细节';
        zoom.setAttribute('aria-pressed', String(expanded));
        stage.scrollTo(expanded ? (stage.scrollWidth - stage.clientWidth) / 2 : 0, 0);
      });
      stage.addEventListener('pointerdown', (event) => {
        if (!stage.classList.contains('is-zoomed') || !event.isPrimary || event.button !== 0 || drag) return;
        const bounds = stage.getBoundingClientRect();
        // Keep the native scrollbars usable as an alternative to dragging.
        if (event.clientX >= bounds.left + stage.clientWidth || event.clientY >= bounds.top + stage.clientHeight) return;
        event.preventDefault();
        stage.focus({ preventScroll: true });
        drag = { pointerId: event.pointerId, x: event.clientX, y: event.clientY, left: stage.scrollLeft, top: stage.scrollTop };
        stage.setPointerCapture(event.pointerId);
        stage.classList.add('is-dragging');
      });
      stage.addEventListener('pointermove', (event) => {
        if (!drag || event.pointerId !== drag.pointerId) return;
        stage.scrollLeft = drag.left - (event.clientX - drag.x);
        stage.scrollTop = drag.top - (event.clientY - drag.y);
      });
      const finishDragging = (event: PointerEvent) => {
        if (event.pointerId === drag?.pointerId) stopDragging();
      };
      window.addEventListener('pointerup', finishDragging);
      window.addEventListener('pointercancel', finishDragging);
      stage.addEventListener('lostpointercapture', finishDragging);
      const closeFigure = () => lightbox.close();
      lightbox.querySelector('.lightbox-close')!.addEventListener('click', closeFigure);
      const outsideImageViewer = (event: MouseEvent) => {
        const bounds = lightbox.getBoundingClientRect();
        return event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom;
      };
      lightbox.addEventListener('pointerdown', (event) => {
        backdropPressed = event.target === lightbox && outsideImageViewer(event);
      });
      lightbox.addEventListener('click', (event) => {
        if (backdropPressed && event.target === lightbox && outsideImageViewer(event)) closeFigure();
        backdropPressed = false;
      });
      lightbox.addEventListener('close', () => {
        backdropPressed = false;
        resetZoom();
        image.removeAttribute('src');
        returnFocus?.focus({ preventScroll: true });
      });
      window.addEventListener('blur', stopDragging);
      document.addEventListener('visibilitychange', () => { if (document.hidden) stopDragging(); });
    </script>
  </body>
</html>
