---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import { profile, groupName, graduateStudents } from '../data/profile';
const asset = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\/+/, '')}`;
const studentCount = graduateStudents.reduce((sum, cohort) => sum + cohort.students.length, 0);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>学生培养｜{groupName}</title>
    <meta name="description" content={`${groupName}学生培养信息，当前展示按年级排列的硕士研究生名单。`} />
    <meta name="theme-color" content="#f8f7f3" />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    {Astro.site && <link rel="canonical" href={new URL(asset('members/'), Astro.site)} />}
  </head>
  <body id="top">
    <a class="skip-link" href="#main">跳转至主要内容</a>
    <SiteHeader />
    <main id="main" class="members-page" tabindex="-1">
      <nav class="breadcrumb" aria-label="当前位置"><a href={asset('')}>主页</a><span aria-hidden="true">/</span><span aria-current="page">学生培养</span></nav>
      <header class="members-intro">
        <p class="eyebrow" lang="en">Student Mentoring</p>
        <h1>学生培养<span class="heading-dot" aria-hidden="true">.</span></h1>
        <p>硕士研究生 <span aria-hidden="true">·</span> {graduateStudents.length} 个年级 <span aria-hidden="true">·</span> {studentCount} 位同学</p>
      </header>
      <nav class="cohort-nav" aria-label="按年级浏览">{graduateStudents.map((cohort) => <a href={`#cohort-${cohort.year}`}>{cohort.year} 级</a>)}</nav>
      <div class="cohort-list">
        {graduateStudents.map((cohort) => (
          <section id={`cohort-${cohort.year}`} class="cohort" aria-labelledby={`heading-${cohort.year}`}>
            <div class="cohort-heading"><h2 id={`heading-${cohort.year}`}>{cohort.year}<span>级</span></h2><p>{cohort.students.length} 位同学</p></div>
            <ul class:list={['student-list', { 'has-notes': cohort.students.some((student) => student.note) }]}>
              {cohort.students.map((student) => <li class="student-entry"><h3>{student.name}</h3>{student.note && <p class="student-note">{student.note}</p>}</li>)}
            </ul>
          </section>
        ))}
      </div>
      <footer class="footer"><span>{profile.name} <span aria-hidden="true">/</span> <span lang="en">{profile.englishName}</span></span><a href={asset('')}>返回主页 <span aria-hidden="true">→</span></a></footer>
    </main>
  </body>
</html>
